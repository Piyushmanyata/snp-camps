NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for: create volunteers, patient reg-no login accounts, staff invite role elevation
SUPABASE_SERVICE_ROLE_KEY=
# Postgres password (Supabase project settings). Used only by scripts/apply-*.mjs — never commit real value.
SUPABASE_DB_PASSWORD=
ADMIN_INVITE_CODE=change-me-admin
VOLUNTEER_INVITE_CODE=change-me-volunteer
# Absolute site URL used in QR codes (production: https://your-domain.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: HMAC secret for patient QR login tokens (defaults to service role key)
# PATIENT_QR_SECRET=
# Aadhaar auto-fill (DigiLocker / KYC provider). When off, form is fully manual.
# NEXT_PUBLIC_AADHAAR_LOOKUP_ENABLED=true
# AADHAAR_LOOKUP_URL=https://your-provider.example/aadhaar-kyc
# AADHAAR_LOOKUP_SECRET=
