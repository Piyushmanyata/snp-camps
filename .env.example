NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for: create volunteers, patient reg-no login accounts, staff invite role elevation
SUPABASE_SERVICE_ROLE_KEY=
# Postgres password (Supabase project settings). Used only by scripts/apply-*.mjs — never commit real value.
SUPABASE_DB_PASSWORD=
# Use long, random, rotated invite codes; placeholder values are rejected.
ADMIN_INVITE_CODE=
VOLUNTEER_INVITE_CODE=
# Required by scripts/apply-schema.mjs when provisioning the admin.
ADMIN_PASSWORD=
# Absolute site URL embedded in staff-scan QR codes (production: https://your-domain.vercel.app)
# QR is for volunteers/doctors to scan — not patient login.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Aadhaar (configure later) ---
# Verify provider for self-reg OTP/eKYC. Self-reg is disabled until configured.
# AADHAAR_VERIFY_URL=https://your-provider.example/aadhaar-verify
# AADHAAR_VERIFY_SECRET=
# Optional auto-fill (DigiLocker / KYC). When off, form is manual after verify.
# NEXT_PUBLIC_AADHAAR_LOOKUP_ENABLED=true
# AADHAAR_LOOKUP_URL=https://your-provider.example/aadhaar-kyc
# AADHAAR_LOOKUP_SECRET=

# --- SMS / WhatsApp (configure later) ---
# POST JSON webhooks for registration + logout credentials
# SMS_WEBHOOK_URL=https://your-sms.example/send
# WHATSAPP_WEBHOOK_URL=https://your-wa.example/send
# NOTIFY_WEBHOOK_SECRET=
