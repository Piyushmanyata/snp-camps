NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for server-side patient registration and admin-created staff accounts.
SUPABASE_SERVICE_ROLE_KEY=
# One-time initial-admin bootstrap. Remove these values after the first admin exists.
SUPABASE_PROJECT_REF=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
# Absolute site URL embedded in staff-scan QR codes (production: https://your-domain.vercel.app)
# QR is for volunteers/doctors to scan — not patient login.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development


# --- Aadhaar card scan (required for scanned registration) ---
# The QR on the card is parsed offline and assumed authentic — no provider, no
# OTP, no network call (ADR 0004). The eKYC provider variables were removed
# with the OTP flow (#116).
#
# The pepper is the HMAC secret behind the Person duplicate key
# (last4 + normalised name + DOB + gender). Scanner registration and readiness
# fail closed without it.
# NEVER rotate it while a Camp is active: every existing key becomes unmatchable.
# AADHAAR_HASH_PEPPER=

# --- Registration + day-before reminder SMS via MSG91 (optional) ---
# Transactional DLT templates only. Desk works without these.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SNPCP
# MSG91_DLT_TE_ID_REGISTRATION=
# MSG91_DLT_TE_ID_REMINDER=
# MSG91_TEMPLATE_REGISTRATION=
# MSG91_TEMPLATE_REMINDER=
# Vercel Cron auth for /api/cron/reminder-sms (required in production for the job).
# CRON_SECRET=
# Required in production for the reminder cron; optional elsewhere.
# Optional WhatsApp webhook (not used for DLT registration SMS):

# Local verification / maintenance scripts (optional):
# SNP_TEST_DATABASE_URL=
# DATABASE_URL=
# LOAD_BASE_URL=
# LOAD_VUS=25
# LOAD_DURATION_SECONDS=30
# LOAD_PATHS=/,/register,/login
# ALLOW_HIGH_LOAD=false
# SNP_PATIENT_AUTH_CLEANUP=0
# SNP_DEPLOYMENT_AUTHORITY_34=0
# GIT_COMMIT_SHA=
