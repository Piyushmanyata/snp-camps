NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for server-side patient registration and admin-created staff accounts.
SUPABASE_SERVICE_ROLE_KEY=
# One-time initial-admin bootstrap. Remove these values after the first admin exists.
SUPABASE_PROJECT_REF=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
# Absolute site URL embedded in staff-scan QR codes (production: https://your-domain.vercel.app)
# QR is for volunteers/doctors to scan — not patient login.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development


# --- Aadhaar auto-fill (optional) ---
# Aadhaar eKYC self-registration is off unless a provider and pepper are set.
# NEXT_PUBLIC_AADHAAR_LOOKUP_ENABLED=true
# AADHAAR_LOOKUP_URL=https://your-provider.example/aadhaar-kyc
# AADHAAR_LOOKUP_SECRET=
# AADHAAR_KYC_PROVIDER=mock
# AADHAAR_HASH_PEPPER=
# AADHAAR_KYC_PEPPER=
# AADHAAR_PEPPER=
# AADHAAR_KYC_DIGIO_INITIATE_URL=
# AADHAAR_KYC_DIGIO_VERIFY_URL=
# AADHAAR_KYC_DIGIO_URL=
# AADHAAR_KYC_DIGIO_API_KEY=
# AADHAAR_KYC_DIGIO_CLIENT_ID=
# AADHAAR_KYC_DIGIO_CLIENT_SECRET=
# AADHAAR_KYC_DECENTRO_INITIATE_URL=
# AADHAAR_KYC_DECENTRO_VERIFY_URL=
# AADHAAR_KYC_DECENTRO_URL=
# AADHAAR_KYC_DECENTRO_API_KEY=
# AADHAAR_KYC_DECENTRO_CLIENT_ID=
# AADHAAR_KYC_DECENTRO_CLIENT_SECRET=

# --- Registration + day-before reminder SMS via MSG91 (optional) ---
# Transactional DLT templates only. Desk works without these.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SNPCP
# MSG91_DLT_TE_ID_REGISTRATION=
# MSG91_DLT_TE_ID_REMINDER=
# MSG91_TEMPLATE_REGISTRATION=
# MSG91_TEMPLATE_REMINDER=
# Vercel Cron auth for /api/cron/reminder-sms (required in production for the job).
# CRON_SECRET=
# Required in production for the reminder cron; optional elsewhere.
# Optional WhatsApp webhook (not used for DLT registration SMS):
# WHATSAPP_WEBHOOK_URL=https://your-wa.example/send
# NOTIFY_WEBHOOK_SECRET=

# Local verification / maintenance scripts (optional):
# SNP_TEST_DATABASE_URL=
# DATABASE_URL=
# LOAD_BASE_URL=
# LOAD_VUS=25
# LOAD_DURATION_SECONDS=30
# LOAD_PATHS=/,/register,/login
# ALLOW_HIGH_LOAD=false
# SNP_PATIENT_AUTH_CLEANUP=0
# SNP_DEPLOYMENT_AUTHORITY_34=0
# GIT_COMMIT_SHA=
