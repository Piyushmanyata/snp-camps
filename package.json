{
  "name": "snp-camps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --import ./tests/route-loader.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "test:db": "node --no-warnings --test tests/register-patient-idempotent.db.test.mjs tests/link-patient-phone.db.test.mjs tests/staff-person-kpis.db.test.mjs tests/aadhaar-duplicate.db.test.mjs",
    "test:e2e": "node e2e/run-local.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "load:smoke": "node scripts/load-test.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
